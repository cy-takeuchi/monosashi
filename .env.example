# ---------------------------------------------------------------------------
# 検証環境の kintone
#
# 値を直接書く方法と、1Password の参照を書いて op run 経由で解決する方法がある。
# 後者なら秘密情報がディスクに残らないので、そちらを推奨。
#
#   直接:  KINTONE_PASSWORD=actual-password
#   op:    KINTONE_PASSWORD=op://<vault>/<item>/password
#
# op を使う場合の実行方法（--account はユーザー全体の OP_ACCOUNT より優先される）:
#   op run --account <アカウント> --env-file=.env -- pnpm run app:build
#
# 未解決のまま渡ると tools/shared/env.ts が検出して止める（401 で悩まないため）。
# ---------------------------------------------------------------------------
KINTONE_BASE_URL=https://example.cybozu.com
KINTONE_USERNAME=op://<vault>/<item>/username
KINTONE_PASSWORD=op://<vault>/<item>/password

# ---------------------------------------------------------------------------
# アプリを作るスペース
#
# どちらか一方だけを設定する。両方未設定ならスペース配下には作らない。
# ゲストスペースを別変数にしているのは、kintone の API パスが
# /k/guest/{id}/v1/... に変わり、クライアント生成時に指定が必要なため
# （後から切り替えられない）。
#
# スペース ID はスペースの URL から取れる:
#   通常:      https://example.cybozu.com/k/#/space/12       -> 12
#   ゲスト:    https://example.cybozu.com/k/guest/34/        -> 34
# ---------------------------------------------------------------------------
KINTONE_SPACE_ID=
KINTONE_GUEST_SPACE_ID=

# tools/fixture-app/build.ts が書き出す。手で埋めない
FIXTURE_APP_ID=
FIXTURE_LOOKUP_APP_ID=
