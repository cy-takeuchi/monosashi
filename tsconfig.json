{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"noEmit": true,
		"types": ["node"]
	},
	// **e2e を必ず含める。** ここから漏れていた間、`e2e/` は型を誰にも見られて
	// いなかった（`biome` は見るが lint と整形だけ）。`const x: number = "文字列"`
	// を入れても `check` が緑になる状態で、`ProbeApi` を e2e が import している
	// ことを根拠にした「片方だけ直すと tsc が落ちる」という主張が嘘だった。
	// 漏れを test/typecheckScope.test.ts が縛っている
	"include": [
		"src/**/*",
		"test/**/*",
		"tools/**/*",
		"e2e/**/*",
		"examples/**/*",
		"*.config.ts"
	],
	"exclude": ["test/dist/**/*"]
}
