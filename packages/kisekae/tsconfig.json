{
	// compilerOptions はリポジトリのルートの tsconfig.base.json。
	// ここにはこのパッケージ固有のことだけを書く
	"extends": "../../tsconfig.base.json",
	// **`.ts` を置いた場所を全部含める。**
	// 漏れを test/typecheckScope.test.ts が縛っている（tsumekae と同じ）
	"include": ["src/**/*", "test/**/*", "tools/**/*", "*.config.ts"],
	"exclude": ["test/dist/**/*"]
}
