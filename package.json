{
	"name": "kintone-record",
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@11.6.0",
	"description": "Accurate, measurement-backed kintone record types, converters and typeguards.",
	"license": "MIT",
	"files": [
		"dist"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./kintone": {
			"types": "./dist/kintone.d.ts",
			"default": "./dist/kintone.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "pnpm run build:types && pnpm run build:js && pnpm run build:check",
		"build:types": "tsc -p tsconfig.build.json",
		"build:js": "vite build",
		"build:check": "tsc -p tsconfig.dist.json",
		"prepublishOnly": "pnpm run build",
		"tsc": "tsc --noEmit",
		"biome": "biome check --write .",
		"biome:check": "biome check .",
		"probe:build": "vite build --config vite.probe.config.ts",
		"app:build": "tsx tools/fixture-app/build.ts",
		"app:verify": "tsx tools/fixture-app/verify.ts",
		"app:inspect": "tsx tools/fixture-app/inspect.ts",
		"probe:write": "tsx tools/probe-write/writeProbe.ts",
		"probe:converter": "tsx tools/probe-write/verifyConverter.ts",
		"app:deploy-probe": "tsx tools/fixture-app/deployProbe.ts",
		"test": "vitest run --typecheck",
		"e2e": "playwright test",
		"fixture:build": "tsx tools/fixture/build.ts",
		"e2e:install": "playwright install --with-deps chromium"
	},
	"dependencies": {
		"@kintone/rest-api-client": "^6.2.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.4.0",
		"dotenv": "^17.4.2",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"sideEffects": false
}
